# ========================
# Seed import cache
# ========================
# Only manifest.json is committed: it pins the harvest and lists slugs and URLs, no recipe text.
# Everything else is a personal-use cache. Most of the corpus is not public domain, so recipe
# text and photos are never committed or published.
backend/RecipeApp.API/seed-data/**/raw/
backend/RecipeApp.API/seed-data/**/parsed/
# Stage 4 output. Holds recipe text, so it stays local.
backend/RecipeApp.API/seed-data/**/normalised/
backend/RecipeApp.API/seed-data/**/images/
backend/RecipeApp.API/seed-data/**/state.json
backend/RecipeApp.API/seed-data/**/*.tmp
# Catalogue review list. Carries corpus counts and source lines; never shipped.
backend/RecipeApp.API/seed-data/catalogue-review.md
# --build-catalogue output, a curation reference derived from normalised/.
backend/RecipeApp.API/seed-data/myplate/catalogue-build.json

# ========================
# User
# ========================
/temp/