# ── RecipeApp — production settings ───────────────────────────────────────────
# Copy to .env on the self-hosted PC and fill in. .env is git-ignored.
# Read by docker-compose.prod.yml and deploy/update.ps1. See docs/deployment.md.

# Production database password. Generate once, e.g. in PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | ForEach-Object { $_.ToString('x2') })
# Hex keeps it free of characters that need escaping in .env or the connection string (; = $ ").
# The postgres_data volume keeps the password it was first started with. Changing it later
# needs ALTER USER inside the database, not just an edit here.
POSTGRES_PASSWORD=change-me

# Image tag the PC runs. `latest` follows releases. Set a commit SHA to pin or roll back.
RECIPEAPP_IMAGE_TAG=latest

# Host port (bound to 127.0.0.1) that `tailscale serve` targets. Change it if 80 is taken.
# On the development machine, use a port the dev stack does not publish (80, 5000, 5432), e.g. 8090.
RECIPEAPP_HTTP_PORT=80

# How many pre-update database dumps deploy/update.ps1 keeps in deploy/backups/.
RECIPEAPP_BACKUP_KEEP=10

# The Model Server (tools/llm-server), which Scraping needs. See docs/deployment.md, "Model Server".
# The default reaches a server bound to 127.0.0.1 on this PC. For another tailnet machine, use its
# Tailscale IP or MagicDNS name, e.g. http://gpu-box:9931. Changing either needs a container restart.
MODEL_SERVER_URL=http://host.docker.internal:9931
# The same key as ApiKey in tools/llm-server/settings.psd1. Required when the server is on another machine.
MODEL_SERVER_API_KEY=
