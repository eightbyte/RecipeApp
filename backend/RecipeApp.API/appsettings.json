{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=recipeapp;Username=recipeapp;Password=CHANGE_ME"
  },
  "RecipeScraping": {
    "HtmlFetchTimeoutSeconds": 15,
    "LlmTimeoutSeconds": 120,
    "MaxHtmlCharacters": 30000,
    "MatchConfidenceThreshold": 0.8,
    "EnableHeadlessFallback": true,
    "MinStaticContentLength": 400,
    "HeadlessRenderTimeoutSeconds": 20,
    "HeadlessMaxConcurrency": 2
  },
  "Llm": {
    "Provider": "Local",
    "Local": {
      "ModelPath": "",
      "ContextSize": 8192,
      "GpuLayerCount": 999,
      "ChatTemplate": "chatml",
      "StopStrings": []
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ImageStorage": {
    "BasePath": "uploads/images",
    "MaxFileSizeMb": 10,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ]
  }
}
