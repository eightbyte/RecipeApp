<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- xunit v3 test projects are self-hosting executables. Previously supplied
         implicitly by Microsoft.NET.Test.Sdk; that package is no longer referenced. -->
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit v3 — test framework plus the built-in Microsoft.Testing.Platform runner.
         From 4.0.0 this is MTP-only: the VSTest bridge (Microsoft.NET.Test.Sdk +
         xunit.runner.visualstudio) is gone, and `dotnet test` reaches it via the
         runner opt-in in global.json at the repository root. -->
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <!-- Code coverage for Microsoft.Testing.Platform, via the `dotnet test` coverage
         switch. Replaces the VSTest-only "XPlat Code Coverage" collector. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.0" />
    <!-- Assertions and validation helpers -->
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <!-- FluentValidation.TestHelper is bundled in the main FluentValidation package.
         Kept explicit and pinned to the same version as RecipeApp.API so the suite
         tests the assembly that actually ships. -->
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <!-- Integration test infrastructure -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <!-- Pin EF Core to match the version used by Npgsql.EntityFrameworkCore.PostgreSQL in the API project -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RecipeApp.API\RecipeApp.API.csproj" />
  </ItemGroup>

</Project>
